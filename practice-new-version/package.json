{
  "name": "langgraph-js-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo run dev",
    "dev:debug": "node scripts/dev.mjs --debug",
    "dev:ui": "turbo run dev --filter=web",
    "dev:agent": "turbo run dev --filter=agent",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build --filter=web",
    "build:agent": "turbo run build --filter=agent",
    "dev:infra": "node scripts/copilotkit-dev-infra.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.11"
  },
  "overrides": {
    "@langchain/core": "1.1.44",
    "@langchain/langgraph": "1.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
