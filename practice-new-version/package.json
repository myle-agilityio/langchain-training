{
  "name": "langgraph-js-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:debug": "node scripts/dev.mjs --debug",
    "dev:ui": "next dev --turbopack",
    "dev:agent": "npm run dev --prefix agent",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "install:agent": "cd agent && npm install",
    "postinstall": "npm run install:agent",
    "dev:infra": "node scripts/copilotkit-dev-infra.mjs"
  },
  "dependencies": {
    "@copilotkit/a2ui-renderer": "1.62.3",
    "@copilotkit/react-core": "1.62.3",
    "@copilotkit/runtime": "1.62.3",
    "@langchain/langgraph-sdk": "^1.9.27",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.10",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-rnd": "^10.5.2",
    "react18-json-view": "^0.2.9",
    "recharts": "^3.7.0",
    "shiki": "^3.22.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@langchain/core": "1.1.44",
    "@langchain/langgraph": "1.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
