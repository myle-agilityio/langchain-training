{
  "name": "langgraph-js-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo run dev",
    "dev:ui": "turbo run dev --filter=web",
    "dev:agent": "turbo run dev --filter=agent",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build --filter=web",
    "build:agent": "turbo run build --filter=agent",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "turbo": "2.10.11",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "@langchain/core": "1.1.44",
    "@langchain/langgraph": "1.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
