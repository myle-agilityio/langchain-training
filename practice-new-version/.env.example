AGENT_URL=http://localhost:8123
OPENAI_API_KEY=
LANGSMITH_API_KEY=
# Turns on LangSmith tracing for every graph run (langgraphjs dev picks these up automatically).
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-email-assistant

# Postgres holding the application data (inbox + contact profiles). Any Postgres works —
# a local install or a hosted one (Neon, Supabase). Tables are created on first connect.
# Local example:  postgresql://postgres:password@localhost:5432/teacher_inbox
DATABASE_URL=

# --- CopilotKit Intelligence (optional; set COPILOTKIT_LICENSE_TOKEN to enable Threads — server + UI) ---
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# INTELLIGENCE_API_KEY=
