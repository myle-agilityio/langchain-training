# Agent env — read by `langgraphjs dev` via langgraph.json's "env": ".env".
# The web app has its own apps/web/.env; COPILOTKIT_LICENSE_TOKEN is needed in both.

# Deployment URL the CopilotKit runtime points its LangGraphAgent at.
AGENT_URL=http://localhost:8123

# BYOK: the app itself no longer uses this for chat/classify/draft/RAG — each visitor pastes
# their own key in the browser (see the "Enter your OpenAI API key" prompt). This one is only
# a fallback for /api/threads' title-gen and the one-time seed of the shared knowledge base on
# a fresh database — safe to leave unset once that's already seeded.
OPENAI_API_KEY=

# Postgres holding the application data (inbox + contact profiles). Any Postgres works —
# a local install or a hosted one (Neon, Supabase). Tables are created on first connect.
# Local example:  postgresql://postgres:password@localhost:5432/teacher_inbox
DATABASE_URL=

# Minimum cosine similarity (0-1, higher=more relevant) a knowledge-base match must clear to be
# used as grounding for a reply. Below this, results are dropped rather than shown. Default: 0.65.
RAG_SCORE_THRESHOLD=0.65

# Turns on LangSmith tracing for every graph run (langgraphjs dev picks these up automatically).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-email-assistant
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- CopilotKit Intelligence (optional; set COPILOTKIT_LICENSE_TOKEN to enable Threads) ---
# Set the same token in apps/web/.env to derive the UI's Threads flag.
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# INTELLIGENCE_API_KEY=
