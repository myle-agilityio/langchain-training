# Web env — read by vite.config.ts at build/dev time (loadEnv, no VITE_ prefix required).
# Nothing here is read at runtime by src/; the agent owns configuration (apps/agent/.env).

# Its presence derives VITE_COPILOTKIT_THREADS_ENABLED. Set the token, never the flag.
# The agent needs its own copy in apps/agent/.env.
# COPILOTKIT_LICENSE_TOKEN=

# Deploy-time only — vercel.json rewrites /api/* to it. Ignored in dev (Vite proxies to :8123).
# AGENT_URL=
