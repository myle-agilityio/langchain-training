{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "apps/web/dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "${AGENT_URL}/api/$1", "env": ["AGENT_URL"] },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
