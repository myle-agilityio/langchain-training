#!/usr/bin/env sh
# Lints/format-checks only the practice-new-version files actually being pushed —
# not the whole repo — so this doesn't choke on code from before prettier/eslint existed.

zero="0000000000000000000000000000000000000000"
any_failed=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "$local_oid" ] && continue
  [ "$local_oid" = "$zero" ] && continue # deleting a ref, nothing to check

  if [ "$remote_oid" = "$zero" ]; then
    # New branch/ref on the remote — no prior state to diff against there.
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      base=$(git merge-base "$local_oid" origin/main)
    else
      base=$(git hash-object -t tree /dev/null) # empty tree: diff the whole pushed history
    fi
  else
    base="$remote_oid"
  fi

  # --diff-filter=d drops files deleted in this range: eslint/prettier abort on paths that no longer exist.
  # Pathspec, not grep: git diff exits 0 on no match, grep exits 1 — and husky runs this with `sh -e`.
  files=$(git diff --name-only --diff-filter=d "$base" "$local_oid" -- \
    'practice-new-version/apps/*.ts' 'practice-new-version/apps/*.tsx' \
    'practice-new-version/apps/*.js' 'practice-new-version/apps/*.jsx')

  [ -z "$files" ] && continue

  echo "pre-push: checking $(echo "$files" | wc -l) file(s) in practice-new-version ($local_ref)"

  # -n 25: npx shells out through cmd.exe, which caps a command line at 8191 chars — one batch
  # of every changed path blows past that and dies with "The command line is too long."
  if ! echo "$files" | xargs -n 25 npx --prefix practice-new-version eslint; then
    any_failed=1
  fi
  if ! echo "$files" | xargs -n 25 npx --prefix practice-new-version prettier --check; then
    any_failed=1
  fi
done

if [ "$any_failed" = "1" ]; then
  echo ""
  echo "pre-push: lint/format check failed on files in this push."
  echo "Run 'pnpm lint:fix' and 'pnpm format' inside practice-new-version, then commit and push again."
  exit 1
fi

exit 0
